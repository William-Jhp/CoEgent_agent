          }
        },
        "required": []
      },
      "returns": "tuple: [0]=RGB numpy 배열, [1]=None. opaque 영상 데이터.",
      "kind": "camera"
    },
    {
      "name": "RobotBackend.ensure_nav_active",
      "file": "planner/a2sim/robot/backend.py",
      "description": "Nav2 controller lifecycle 활성 상태를 확인하고 필요시 STARTUP.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "returns": "string: already active 또는 started. 실패 시 RobotError.",
      "kind": "lifecycle"
    },
    {
      "name": "GridNavigator.plan",
      "file": "planner/a2sim/nav/grid_nav.py",
      "description": "주행 가능 격자에서 경로만 계산한다. 로봇을 이동시키지 않는다. start_xy는 현재 측정 좌표나 명시 입력 필요.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_xy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "goal_xy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "start_xy",
          "goal_xy"
        ]
      },
      "returns": "Nx2 numpy 좌표 배열 또는 None (도달 불가).",
      "kind": "path_planning"
    },
    {
      "name": "WorldState.capture_views",
      "file": "planner/scripts/world_state_node.py",
      "description": "WorldState의 최신 360/전방 카메라 뷰를 캡처한다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "returns": "tuple: [0]=views(list of label/PIL image), [1]=stamp, [2]=received, [3]=source. 영상은 opaque.",
      "kind": "camera"
    },
    {
      "name": "WorldState.describe",
      "file": "planner/scripts/world_state_node.py",
      "description": "capture_views가 반환한 views로 장면/사람/문자/장애물 가능성 분석. 이동 가능성이나 물체 좌표를 확정하지 않는다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "views": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "$result": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "index": {
                "type": "integer",
                "const": 0
              }
            },
            "required": [
              "$result",
              "index"
            ]
          }
        },
        "required": [
          "views"
        ]
      },
      "returns": "LLM reply 객체의 data: summary, people_visible, readable_text, possible_obstruction. verified 측정 아님.",
      "kind": "vision"
    }
  ]
}

# Track only the CoEgent projects in this shared workspace.
/*
!/.gitignore
!/README.md
!/CoEgent_Agent/
!/Executor_Adapters/
!/A2_Execution_Adapter/
!/LLM_Model_Server/

# Local environments, generated files, model weights and private settings.
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/.venv/
**/venv/
**/build/
**/dist/
**/results/
**/.env
**/.env.*
!**/.env.example
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/*.db
**/*.log
**/*.pid
**/*.lock
**/*.gguf
**/*.safetensors
**/*.pt
**/*.pth
**/*.pem
**/*.key
/LLM_Model_Server/model/
/LLM_Model_Server/runtimes/
/LLM_Model_Server/run/
/LLM_Model_Server/logs/
/A2_Execution_Adapter/runtime/
/A2_Execution_Adapter/maps/

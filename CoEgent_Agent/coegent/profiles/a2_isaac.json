{
  "profile": "a2-isaac",
  "version": 1,
  "tools": [
    {
      "name": "RobotBackend.go_to",
      "file": "planner/a2sim/robot/backend.py",
      "description": "현재 위치에서 지도 좌표 x,y까지 경로 계산과 추종. 목적지만 지정하며 waypoint를 LLM이 만들지 않는다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "returns": "bool: 경로 없음/이동 실패는 False. 도착 근거는 별도 확인.",
      "kind": "motion"
    },
    {
      "name": "RobotBackend.localize",
      "file": "planner/a2sim/robot/backend.py",
      "description": "설정된 저장 지도에서 localization 시작, READY와 최신 TF를 기다린다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "returns": "dict: ready_s(number), task_id(string).",
      "kind": "localization"
    },
    {
      "name": "RobotBackend.stop_localization",
      "file": "planner/a2sim/robot/backend.py",
      "description": "localization 종료 명령 발행. 반환 자체가 종료 확인을 의미하지 않는다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "grace_s": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": []
      },
      "returns": "None; 종료 상태 확인은 실행 adapter가 담당.",
      "kind": "localization"
    },
    {
      "name": "RobotBackend.refresh_pose",
      "file": "planner/a2sim/robot/backend.py",
      "description": "최신 TF 위치를 확인한다. stale/누락이면 RobotError.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max_age": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": []
      },
      "returns": "RobotState 객체. 위치/방향은 x,y,z,yaw 속성. JSON 변환은 adapter 필요.",
      "kind": "observation"
    },
    {
      "name": "RobotBackend.check_battery",
      "file": "planner/a2sim/robot/backend.py",
      "description": "배터리 비율 조회와 설정된 최소 잔량 검사. 누락/낮은 잔량이면 RobotError.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "returns": "float 0..1 (백분율 0..100 아님).",
      "kind": "observation"
    },
    {
      "name": "RobotBackend.observe",
      "file": "planner/a2sim/robot/backend.py",
      "description": "전방 카메라 최신 RGB 영상 획득/보정. 의미 분석은 수행하지 않는다.",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "yaw_offset": {
            "type": "number",
